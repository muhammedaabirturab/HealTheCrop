ENV=development
DEBUG=true

DATABASE_URL=sqlite:///./healthecrop.db
# Production example: postgresql+psycopg2://healthecrop:password@localhost:5432/healthecrop

JWT_SECRET_KEY=CHANGE_ME_use_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_MINUTES=10080

CORS_ORIGINS=["http://localhost:5173","http://localhost:4173","http://127.0.0.1:5173","http://127.0.0.1:4173"]

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_IMAGES=healthecrop-images
MINIO_BUCKET_REPORTS=healthecrop-reports
LOCAL_STORAGE_FALLBACK_DIR=./storage/local

WEATHER_API_KEY=
